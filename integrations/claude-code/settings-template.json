{
  "//": "REFERENCE ONLY — prefer `python integrations/claude-code/install.py`, which merges into ~/.claude/settings.json without clobbering existing settings and supports --uninstall. Shape verified against Claude Code 2.1.240; the installer writes the exec form with absolute paths, which is what you want on Windows.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"_meta/hooks/recall_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"_meta/hooks/recall_domain.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"_meta/hooks/episode_checkpoint.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"_meta/hooks/episode_stub.py\""
          }
        ]
      }
    ]
  }
}
